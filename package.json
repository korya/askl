{
  "name": "@korya/askl",
  "version": "0.2.1",
  "description": "Deterministic linter for agent skills and agent plugins: agentskills.io, agent-plugins.org, Claude Code, and Codex compliance.",
  "type": "module",
  "license": "MIT",
  "author": "korya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korya/askl.git"
  },
  "homepage": "https://github.com/korya/askl#readme",
  "bugs": "https://github.com/korya/askl/issues",
  "keywords": [
    "linter",
    "agent-skills",
    "agent-plugins",
    "skill-md",
    "claude-code",
    "codex",
    "github-action",
    "sarif"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "askl": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "ajv": "^8.17.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
